  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Bayangkan saat sebuah meriam menembakkan peluru secara miring. Moncong
    meriam tersebut akan membentuk sebuah sudut terhadap tanah.


    Sudut inilah
    yang memaksa peluru meriam bergerak secara horizontal (maju) dan vertikal (naik)
    secara bersamaan.


    Karena kedua gerakan tersebut bekerja bersama-sama dalam
    satu waktu, maka terciptalah lintasan melengkung indah yang kita sebut Gerak
    Parabola.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
